# Copy to deploy/.env and fill in. Never commit the real .env file.
# Public host name that points to this server, without https://
SITE_ADDRESS=sitetrack.example.com
# Random values, for example: openssl rand -base64 36
DB_PASSWORD=
APP_JWT_SECRET=
# Used only on the very first start, when no Admin exists yet. You can remove these afterwards.
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_NAME=Administrator
APP_BOOTSTRAP_ADMIN_PASSWORD=
